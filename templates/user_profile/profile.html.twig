{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">

        {# =======================
           MENU LATÉRAL
        ======================= #}
        {% include 'dashboard/_sidebar.html.twig' %}

          {# CONTENU (reste 9 colonnes) #}
        <main class="col-12 col-md-9">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h1 class="h4 mb-4">Modifier mon profil</h1>

                    {{ form_start(profilForm) }}

                    <div class="row g-3">

                        {# COLONNE GAUCHE #}
                        <div class="col-12 col-md-6">
                            {{ form_row(profilForm.firstname) }}
                            {{ form_row(profilForm.phoneNumber) }}
                            {{ form_row(profilForm.street) }}
                            {{ form_row(profilForm.postalCode) }}
                        </div>

                        {# COLONNE DROITE #}
                        <div class="col-12 col-md-6">
                            {{ form_row(profilForm.lastname) }}
                            {{ form_row(profilForm.addressComplement) }}
                            {{ form_row(profilForm.city) }}

                            {% if profilForm.roles is defined %}
                                {{ form_row(profilForm.roles) }}
                            {% endif %}
                        </div>

                    </div>

                    <div class="text-end mt-4">
                        <button class="btn btn-primary">
                            Mettre à jour
                        </button>
                    </div>

                    {{ form_end(profilForm) }}

                </div>
            </div>
        </main>

    </div>
</div>
{% endblock %}