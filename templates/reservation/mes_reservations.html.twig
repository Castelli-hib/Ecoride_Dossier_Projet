{% extends 'base.html.twig' %}

{% block title %}Mes réservations
{% endblock %}

{% block body %}
	<div class="container-fluid mt-4">
		<div
			class="row">

			{# SIDEBAR #}
			{% include 'dashboard/_sidebar.html.twig' %}

			{# CONTENU PRINCIPAL #}
			<main class="col-12 col-md-9">

				<div class="card shadow-sm">
					<div class="card-body">

						<h1 class="h4 mb-4">Mes réservations</h1>

						{% if reservations is empty %}
							<div class="alert alert-info">
								Vous n’avez encore aucune réservation.
							</div>
						{% else %}
							<div class="table-responsive">
								<table class="table align-middle">
									<thead class="table-light">
										<tr>
											<th>Trajet</th>
											<th>Date</th>
											<th>Conducteur</th>
											<th>Statut</th>
										</tr>
									</thead>
									<tbody>
										{% for reservation in reservations %}
											<tr>
												<td>
													{{ reservation.route.departureCity }}
													→
													{{ reservation.route.arrivalCity }}
												</td>
												<td>
													{{ reservation.dateReservation|date('d/m/Y') }}
												</td>
												<td>
													{{ reservation.route.user.firstname }}
													{{ reservation.route.user.lastname }}
												</td>
												<td>
													{% if reservation.isConfirmed %}
														<span class="badge bg-success">
															Confirmée
														</span>
													{% else %}
														<span class="badge bg-warning text-dark">
															En attente
														</span>
													{% endif %}
												</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						{% endif %}

					</div>
				</div>

			</main>

		</div>
	</div>
{% endblock %}
