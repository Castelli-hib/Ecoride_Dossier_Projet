{% set currentRoute = app.request.attributes.get('_route') %}

<div class="col-md-3">
	<div class="list-group">

		<a href="{{ path('app_dashboard') }}"
		   class="list-group-item list-group-item-action
		   {{ currentRoute == 'app_dashboard' ? 'active' : '' }}">
			Mon compte
		</a>

		<a href="{{ path('app_user_profile') }}"
		   class="list-group-item list-group-item-action
		   {{ currentRoute == 'app_user_profile' ? 'active' : '' }}">
			Modifier mon profil
		</a>

		<a href="{{ path('credits_index') }}"
		   class="list-group-item list-group-item-action
		   {{ currentRoute == 'credits_index' ? 'active' : '' }}">
			Mes crédits
		</a>

		<a href="{{ path('avis_index') }}"
		   class="list-group-item list-group-item-action
		   {{ currentRoute == 'avis_index' ? 'active' : '' }}">
			Mes avis
		</a>

		{% if "ROLE_CONDUCTEUR" in app.user.roles %}
			<a href="{{ path('app_dashboard_add_route') }}"
			   class="list-group-item list-group-item-action
			   {{ currentRoute == 'app_dashboard_add_route' ? 'active' : '' }}">
				Ajouter un trajet
			</a>

			{# ancre → même route dashboard #}
			<a href="{{ path('app_dashboard') }}#trajets"
			   class="list-group-item list-group-item-action
			   {{ currentRoute == 'app_dashboard' ? 'active' : '' }}">
				Mes trajets
			</a>

			<a href="{{ path('app_user_vehicles') }}"
			   class="list-group-item list-group-item-action
			   {{ currentRoute == 'app_user_vehicles' ? 'active' : '' }}">
				Mes véhicules
			</a>

			<a href="#"
			   class="list-group-item list-group-item-action">
				Mes préférences
			</a>
		{% endif %}

		{% if "ROLE_PASSAGER" in app.user.roles %}
			<a href="{{ path('app_user_reservations') }}"
			   class="list-group-item list-group-item-action
			   {{ currentRoute == 'app_user_reservations' ? 'active' : '' }}">
				Mes réservations
			</a>
		{% endif %}

	</div>
</div>
