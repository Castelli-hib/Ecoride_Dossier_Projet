{% extends 'base.html.twig' %}

{% block title %}Mes crédits{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
  <div class="row">

     {# =======================
           MENU LATÉRAL
        ======================= #}
        {% include 'dashboard/_sidebar.html.twig' %}

    <!-- CONTENU PRINCIPAL -->
    <div class="col-md-9">

      <h2>Mes crédits</h2>

      <p class="mb-4">
        <strong>Solde actuel :</strong>
        {{ balance|number_format(2, ',', ' ') }} €
      </p>

      {% if credits is not empty %}
        <ul class="list-group mb-4">
          {% for credit in credits %}
            <li class="list-group-item d-flex justify-content-between align-items-start">
              <div>
                <strong>{{ credit.type|capitalize }}</strong><br>
                <small class="text-muted">
                  {{ credit.createdAt|date('d/m/Y H:i') }}
                </small>

                {% if credit.description %}
                  <div class="text-muted small">
                    {{ credit.description }}
                  </div>
                {% endif %}
              </div>

              <span class="badge bg-secondary fs-6">
                {{ credit.amount }} €
              </span>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p>Aucun mouvement pour le moment.</p>
      {% endif %}

    </div>
  </div>
</div>
{% endblock %}
