{% extends 'base.html.twig' %}

{% block title %}Réservations{% endblock %}

{% block body %}
<div class="container-fluid my-4">
    <div class="row">

        {% include 'partials/_admin_sidebar.html.twig' %}

        <main class="col-12 col-md-9 col-lg-10">

            {# TITRE #}
            <div class="mb-4">
                <h1 class="fw-bold">Réservations</h1>
                <p class="text-muted mb-0">
                    Suivi de l’activité de réservation sur la plateforme
                </p>
            </div>

            {# KPI RÉSERVATIONS #}
            <div class="row g-4 mb-5">

                <div class="col-6 col-lg-3">
                    <div class="card shadow-sm text-center h-100">
                        <div class="card-body">
                            <div class="text-muted small">Total réservations</div>
                            <div class="fs-3 fw-bold">128</div>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="card shadow-sm text-center h-100">
                        <div class="card-body">
                            <div class="text-muted small">Ce mois</div>
                            <div class="fs-3 fw-bold text-success">+18</div>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="card shadow-sm text-center h-100">
                        <div class="card-body">
                            <div class="text-muted small">Moyenne mensuelle</div>
                            <div class="fs-3 fw-bold">10,6</div>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="card shadow-sm text-center h-100">
                        <div class="card-body">
                            <div class="text-muted small">Tendance</div>
                            <div class="fs-4 fw-semibold text-success">↗ Stable</div>
                        </div>
                    </div>
                </div>

            </div>

            {# GRAPHIQUE PRINCIPAL #}
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold">
                    Réservations par mois
                </div>
                <div class="card-body">
                    <canvas id="chartReservations" height="120"></canvas>
                </div>
            </div>

            {# + GRAPHIQUE SECONDAIRE (OPTIONNEL) #}
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-semibold">
                    Comparaison mensuelle (volume)
                </div>
                <div class="card-body">
                    <canvas id="chartReservationsBar" height="120"></canvas>
                </div>
            </div>

        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
/* ==========================
   KIT RÉSERVATIONS — AUTONOME
   ========================== */

const RESA_MONTHS = [
    'Jan','Feb','Mar','Apr','Mai','Juin',
    'Juil','Aout','Sept','Oct','Nov','Dec'
];

const RESA_VALUES = [
    3, 7, 5, 8,
    6, 9, 7, 10,
    8, 6, 12, 11
];

/* LINE CHART */
new Chart(document.getElementById('chartReservations'), {
    type: 'line',
    data: {
        labels: RESA_MONTHS,
        datasets: [{
            label: 'Réservations',
            data: RESA_VALUES,
            tension: 0.35,
            fill: true,
            borderColor: 'rgba(25,135,84,0.9)',
            backgroundColor: 'rgba(25,135,84,0.2)',
            pointRadius: 4
        }]
    },
    options: {
        responsive: true,
        scales: {
            y: { beginAtZero: true }
        }
    }
});

/* BAR CHART */
new Chart(document.getElementById('chartReservationsBar'), {
    type: 'bar',
    data: {
        labels: RESA_MONTHS,
        datasets: [{
            label: 'Volume',
            data: RESA_VALUES,
            backgroundColor: 'rgba(25,135,84,0.6)',
            borderRadius: 6
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: false }
        },
        scales: {
            y: { beginAtZero: true }
        }
    }
});
</script>
{% endblock %}
