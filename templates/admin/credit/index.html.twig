{% extends 'base.html.twig' %}

{% block title %}Crédits{% endblock %}

{% block body %}
<div class="container-fluid my-4">
    <div class="row">

        {% include 'partials/_admin_sidebar.html.twig' %}

        <main class="col-12 col-md-9 col-lg-10">

            {# TITRE #}
            <div class="mb-4">
                <h1 class="fw-bold">Crédits</h1>
                <p class="text-muted mb-0">
                    Suivi des flux de crédits générés par la plateforme
                </p>
            </div>

            {# KPI CRÉDITS #}
            <div class="row g-4 mb-5">

                <div class="col-6 col-lg-3">
                    <div class="card shadow-sm text-center h-100">
                        <div class="card-body">
                            <div class="text-muted small">Crédits totaux</div>
                            <div class="fs-3 fw-bold">4 820 €</div>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="card shadow-sm text-center h-100">
                        <div class="card-body">
                            <div class="text-muted small">Ce mois</div>
                            <div class="fs-3 fw-bold text-success">+620 €</div>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="card shadow-sm text-center h-100">
                        <div class="card-body">
                            <div class="text-muted small">Moyenne mensuelle</div>
                            <div class="fs-3 fw-bold">402 €</div>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="card shadow-sm text-center h-100">
                        <div class="card-body">
                            <div class="text-muted small">Tendance</div>
                            <div class="fs-4 fw-semibold text-success">↗ Positive</div>
                        </div>
                    </div>
                </div>

            </div>

            {# GRAPHIQUE #}
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-semibold">
                    Crédits générés par mois (€)
                </div>
                <div class="card-body">
                    <canvas id="chartCredits" height="120"></canvas>
                </div>
            </div>

        </main>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
/* ==========================
   KIT CHART.JS — AUTONOME
   ========================== */

const CREDIT_MONTHS = [
    'Jan','Feb','Mar','Apr','Mai','Juin',
    'Juil','Aout','Sept','Oct','Nov','Dec'
];

const CREDIT_VALUES = [
    200, 350, 150, 400,
    300, 450, 500, 400,
    350, 300, 600, 550
];

new Chart(document.getElementById('chartCredits'), {
    type: 'bar',
    data: {
        labels: CREDIT_MONTHS,
        datasets: [{
            label: 'Crédits (€)',
            data: CREDIT_VALUES,
            borderRadius: 6,
            backgroundColor: 'rgba(220,53,69,0.6)'
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: false }
        },
        scales: {
            y: { beginAtZero: true }
        }
    }
});
</script>
{% endblock %}
