{% extends 'base.html.twig' %}

{% block title %}Avis{% endblock %}

{% block body %}
<div class="container-fluid my-4">
    <div class="row">

        {% include 'partials/_admin_sidebar.html.twig' %}

        <main class="col-12 col-md-9 col-lg-10">
            <div class="mb-4">
                <h1 class="fw-bold">Avis</h1>
                <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                <div class="text-muted small">Total avis</div>
                <div class="fs-3 fw-bold">192</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                <div class="text-muted small">Note moyenne</div>
                <div class="fs-3 fw-bold text-warning">4.4 ★</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                <div class="text-muted small">Avis ce mois</div>
                <div class="fs-3 fw-bold text-success">+22</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                <div class="text-muted small">Tendance</div>
                <div class="fs-3 fw-semibold text-success">↗ Positive</div>
            </div>
        </div>
    </div>
</div>

                <p class="text-muted mb-0">Avis des utilisateurs sur les trajets</p>
            </div>
            <!-- Répartition des notes -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Répartition des notes</div>
    <div class="card-body">
        {% for star, value in {5:45,4:30,3:15,2:7,1:3} %}
        <div class="d-flex align-items-center mb-2">
            <div class="me-2 fw-semibold">{{ star }}★</div>
            <div class="progress flex-grow-1" style="height: 8px;">
                <div class="progress-bar bg-warning" style="width: {{ value }}%"></div>
            </div>
            <div class="ms-2 text-muted small">{{ value }}%</div>
        </div>
        {% endfor %}
    </div>
</div>
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-semibold">Avis reçus par mois</div>
                <div class="card-body">
                    <canvas id="chartAvis" height="120"></canvas>
                </div>
            </div>
        </main>
    </div>
</div>



    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
const ctx = document.getElementById('chartAvis').getContext('2d');
const gradient = ctx.createLinearGradient(0, 0, 0, 200);
gradient.addColorStop(0, 'rgba(255,193,7,0.4)');
gradient.addColorStop(1, 'rgba(255,193,7,0)');

new Chart(ctx, {
    type: 'line',
    data: {
        labels: {{ months|default(['Jan','Feb','Mar','Apr','Mai','Juin','Juil','Aout','Sept','Oct','Nov','Dec'])|json_encode|raw }},
        datasets: [{
            label: 'Avis',
            data: {{ avisPerMonth|default([12,15,10,18,14,16,13,17,19,15,20,22])|json_encode|raw }},
            fill: true,
            backgroundColor: gradient,
            borderColor: 'rgba(255,193,7,0.9)',
            tension: 0.35,
            pointRadius: 4,
            pointBackgroundColor: '#ffc107'
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: '#212529',
                padding: 10
            }
        },
        scales: {
            y: { beginAtZero: true }
        }
    }
});
</script>

{% endblock %}
