{% extends 'base.html.twig' %}

{% block title %}Gestion des avis{% endblock %}

{% block body %}
{% include 'partials/_admin_sidebar.html.twig' %}
<h1 class="fw-bold mb-4">Avis utilisateurs</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Auteur</th>
            <th>Note</th>
            <th>Commentaire</th>
        </tr>
    </thead>
    <tbody>
        {% for avis in avis %}
            <tr>
                <td>{{ avis.user.email }}</td>
                <td>{{ avis.rating }}/5</td>
                <td>{{ avis.comment }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="text-center text-muted">Aucun avis</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
